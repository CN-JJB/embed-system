graph TD
    subgraph Cortex-M3 Task Stack Memory [High Memory -> Low Memory Growth]
        HW_FRAME[Hardware Exception Frame - Pushed Automatically by NVIC on Entry]
        xPSR["xPSR (Bit 24 T-Bit = 1: Thumb State)"]
        PC["PC (Task Entry / Resume Instruction Address)"]
        LR["LR (portTASK_RETURN_ADDRESS / prvTaskExitError: Task Return Trap)"]
        R12["R12 (Intra-Procedure Scratch Register)"]
        R3["R3 (Argument Register 4)"]
        R2["R2 (Argument Register 3)"]
        R1["R1 (Argument Register 2)"]
        R0["R0 (Task Argument: pvParameters)"]

        SW_FRAME[Software Context Frame - Pushed by PendSV_Handler]
        R11["R11 (Callee-Saved Register)"]
        R10["R10 (Callee-Saved Register)"]
        R9["R9 (Callee-Saved Register)"]
        R8["R8 (Callee-Saved Register)"]
        R7["R7 (Callee-Saved Register)"]
        R6["R6 (Callee-Saved Register)"]
        R5["R5 (Callee-Saved Register)"]
        R4["R4 (Callee-Saved Register)"]

        HW_FRAME --> xPSR
        xPSR --> PC
        PC --> LR
        LR --> R12
        R12 --> R3
        R3 --> R2
        R2 --> R1
        R1 --> R0
        R0 --> SW_FRAME
        SW_FRAME --> R11
        R11 --> R10
        R10 --> R9
        R9 --> R8
        R8 --> R7
        R7 --> R6
        R6 --> R5
        R5 --> R4
    end

    subgraph FreeRTOS TCB Linkage
        R4 -.->|PSP after stmdb r0!, {r4-r11}| TOP_OF_STACK["pxTopOfStack (Saved in TCB)"]
        TOP_OF_STACK --> TCB["pxCurrentTCB (TCB_t in SRAM)"]
    end
