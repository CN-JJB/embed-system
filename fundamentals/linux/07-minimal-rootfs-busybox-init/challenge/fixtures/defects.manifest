# P3-M03 Challenge defective overlay manifest (learner-visible defect state).
# Applied on top of a verified real BusyBox staging provisioned by
# scripts/provision_real_busybox_tree.sh. Each line is one op:
#   overlay <relpath>          — copy fixtures/defective_overlay/<relpath> over the tree
#   chmod <mode> <relpath>     — set octal mode (e.g. 644) on <relpath>
#   symlink <relpath> <target> — replace <relpath> with a symlink to <target>
#   remove <relpath>           — delete <relpath> from the provisioned tree
# Lines starting with '#' or empty are ignored. Order is significant.
overlay etc/inittab
overlay etc/init.d/rcS
chmod 644 etc/init.d/rcS
symlink bin/ls stale_target
