      "status_enabled": true
    },
    "virtio_window_1": {
      "path": "/virtio_mmio@a000200",
      "compatible": ["virtio,mmio"],
      "reg": [167772672, 512],
      "interrupts": [0, 17, 1],
      "status_enabled": true
    },
    "virtio_window_3": {
      "path": "/virtio_mmio@a000600",
      "compatible": ["virtio,mmio"],
      "reg": [167773696, 512],
      "interrupts": [0, 19, 1],
      "status_enabled": true
    }
