/*
 * ============================================================================
 * ORIGINAL PEDAGOGICAL PSEUDOCODE — NOT UPSTREAM LINUX SOURCE
 * ============================================================================
 *
 * This file is an illustrative pedagogical abstraction created to teach the
 * ARMv7-A reset-to-MMU startup flow. It is NOT upstream Linux source code.
 *
 * Learners MUST inspect the canonical pinned upstream source:
 *   Repository: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
 *   Commit:     7cfc41f8e80f11ffa8382ed1a505154ceffb79c7 (Linux 6.18.50 LTS)
 *   Path:       arch/arm/kernel/head.S
 *
 * Real Upstream Sequence:
 *   stext (MMU off)
 *   -> processor / platform validation (__lookup_processor_type, __vet_atags)
 *   -> __create_page_tables (builds initial 16 KB L1 Translation Table in RAM)
 *        [Note: UART mapped here ONLY if CONFIG_DEBUG_LL=y, NOT standard earlycon]
 *   -> processor-specific setup (e.g., __v7_setup in proc-v7.S: TTBCR/TTBR preparation)
 *   -> MMU enable transition: __enable_mmu loads DACR (CP15 c3) + TTBR0 (CP15 c2),
 *      then __turn_mmu_on writes SCTLR and issues instr_sync (see pinned head.S)
 *   -> __mmap_switched (sp, BSS zeroing, branches to start_kernel in virtual space)
 * ============================================================================
 */

	.arm
	__HEAD
ENTRY(stext)
	@ 1. CPU supervisor mode and mask interrupts
	safe_svcmode_maskall r9

	@ 2. Validate processor ID via CP15 MIDR
	mrc	p15, 0, r9, c0, c0		@ read MIDR
	bl	__lookup_processor_type		@ r5 = procinfo pointer
	movs	r10, r5
	beq	__error_p			@ invalid CPU error

	@ 3. Validate DTB address passed in r2
	bl	__vet_atags

	@ 4. Populate initial L1 translation table (PGD) in physical RAM
	bl	__create_page_tables

	@ 5. Set up return address to virtual space after MMU enable
	ldr	r13, =__mmap_switched
	b	__enable_mmu
ENDPROC(stext)

/*
 * Pedagogical summary of page table creation
 */
__create_page_tables:
	@ In real upstream source:
	@ Builds 16 KB Level 1 page directory at physical base of RAM.
	@ Identity-maps turn-on code.
	@ Maps kernel virtual space (0xC0000000 -> physical RAM).
	@ Maps early serial IO ONLY IF CONFIG_DEBUG_LL is enabled.
	ret	lr
ENDPROC(__create_page_tables)

/*
 * Pedagogical summary of the MMU enable transition
 */
__enable_mmu:
	@ In real upstream source:
	@ __enable_mmu loads the domain access register (CP15 c3) and TTBR0 (CP15 c2)
	@ from values prepared by the page-table / processor-setup code, then
	@ branches to __turn_mmu_on. __turn_mmu_on writes the SCTLR control register
	@ with the MMU enable bit, issues instruction-sync barriers, and returns to
	@ the virtual-space address in r13 (__mmap_switched). Read the exact register
	@ sequence in arch/arm/kernel/head.S and arch/arm/mm/proc-v7.S.
	mov	pc, r13
ENDPROC(__enable_mmu)

__mmap_switched:
	@ Execution now in virtual memory (0xC0000000+)
	mov	sp, r4				@ set initial C runtime stack
	bl	__clear_bss			@ clear kernel BSS
	b	start_kernel			@ branch to architecture-independent C startup
ENDPROC(__mmap_switched)
