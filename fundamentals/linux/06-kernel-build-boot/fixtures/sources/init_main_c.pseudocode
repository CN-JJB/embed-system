/*
 * ============================================================================
 * ORIGINAL PEDAGOGICAL PSEUDOCODE — NOT UPSTREAM LINUX SOURCE
 * ============================================================================
 *
 * This file is an illustrative pedagogical abstraction created to teach the
 * kernel C startup sequence from start_kernel() to userspace handoff.
 * It is NOT upstream Linux source code.
 *
 * Learners MUST inspect the canonical pinned upstream source:
 *   Repository: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
 *   Commit:     7cfc41f8e80f11ffa8382ed1a505154ceffb79c7 (Linux 6.18.50 LTS)
 *   Path:       init/main.c
 * ============================================================================
 */

/*
 * Pedagogical summary of start_kernel() (init/main.c)
 */
void start_kernel(void)
{
	/* 1. Architecture-specific early hardware initialization */
	setup_arch(&command_line);

	/* 2. Memory management initialization */
	mm_init();

	/* 3. Exception vectors and interrupt controllers */
	trap_init();
	early_irq_init();
	init_IRQ();

	/* 4. Console driver initialization */
	console_init();

	/* 5. Spawn kernel_init (PID 1) and enter idle thread */
	arch_call_rest_init();
}

void rest_init(void)
{
	/* Spawn kernel_init thread as PID 1 */
	kernel_thread(kernel_init, NULL, CLONE_FS);

	/* Spawn kthreadd as PID 2 */
	kernel_thread(kthreadd, NULL, CLONE_FS | CLONE_FILES);

	/* Boot CPU becomes idle thread */
	cpu_startup_entry(CPUHP_ONLINE);
}

static int kernel_init(void *unused)
{
	/* Finish subsystem and driver probe */
	do_basic_setup();

	/* Attempt to launch userspace init */
	if (!try_to_run_init_process("/sbin/init") &&
	    !try_to_run_init_process("/etc/init") &&
	    !try_to_run_init_process("/bin/init") &&
	    !try_to_run_init_process("/bin/sh")) {
		/*
		 * In P3-M02, with no rootfs attached, the kernel panics here:
		 * Kernel panic - not syncing: VFS: Unable to mount root fs
		 */
		panic("VFS: Unable to mount root fs on unknown-block(0,0)");
	}
	return 0;
}
