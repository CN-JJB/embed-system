# Phase 3 Canonical Kernel Configuration Fragment
# Platform: ARMv7-A Cortex-A7 on QEMU virt
CONFIG_ARCH_VIRT=y
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARM_LPAE is not set
CONFIG_VMSPLIT_3G=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_PRINTK=y
