# Phase 3 Canonical Kernel Configuration Fragment for QEMU virt Cortex-A7
# Preserves the frozen Phase 3 hardware contract:
# PL011 console/earlycon, devtmpfs, virtio-mmio/blk, ext4, printk, non-LPAE 3G vmsplit.
CONFIG_ARCH_VIRT=y
# CONFIG_ARM_LPAE is not set
CONFIG_VMSPLIT_3G=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_PRINTK=y
